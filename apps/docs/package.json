{
  "name": "@latticeos/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "next dev",
    "build": "next build",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "pnpm validate:content && pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/mdx": "2.0.13",
    "@types/node": "26.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  }
}
