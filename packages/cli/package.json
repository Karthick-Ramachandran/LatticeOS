{
  "name": "@latticeos/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "lattice": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @latticeos/analyzer build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "pretest": "pnpm --filter @latticeos/analyzer build",
    "test": "pnpm test:compile && node --test .test-dist/*.test.js"
  },
  "dependencies": {
    "@latticeos/analyzer": "workspace:*",
    "@latticeos/core": "workspace:*"
  }
}
