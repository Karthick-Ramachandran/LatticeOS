    "@latticeos/core": "0.1.0-rc.0",
    "typescript": "6.0.3"
  },
  "bundledDependencies": [
    "@latticeos/adapter-react",
    "@latticeos/adapter-shadcn",
    "@latticeos/adapter-storybook",
    "@latticeos/adapter-tailwind",
    "@latticeos/analyzer",
